{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dogaga.example/schemas/dogaga-project-0.1.0.schema.json",
  "title": "DOGAGA Project v0.1.0",
  "description": "DOGAGAのUTF-8 JSONプロジェクト形式v0.1.0。元素材は含まない。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "name",
    "createdAt",
    "updatedAt",
    "createdWith",
    "canvas",
    "assets",
    "tracks",
    "lyricDocuments",
    "markers",
    "styles",
    "exportPreset",
    "extensions"
  ],
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "id": {
      "$ref": "#/$defs/Id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "createdAt": {
      "$ref": "#/$defs/UtcDateTime"
    },
    "updatedAt": {
      "$ref": "#/$defs/UtcDateTime"
    },
    "createdWith": {
      "$ref": "#/$defs/CreatedWith"
    },
    "canvas": {
      "$ref": "#/$defs/Canvas"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Asset"
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Track"
      }
    },
    "lyricDocuments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LyricDocument"
      }
    },
    "markers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Marker"
      }
    },
    "styles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TextStyle"
      }
    },
    "exportPreset": {
      "$ref": "#/$defs/ExportPreset"
    },
    "extensions": {
      "$ref": "#/$defs/Extensions"
    }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "TimeUs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "PositiveTimeUs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "SignedTimeUs": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "UtcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "Color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{8}$"
    },
    "Extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9]+(?:[.-][A-Za-z0-9_-]+)+$"
      },
      "additionalProperties": true
    },
    "Rational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "CreatedWith": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "DOGAGA"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "Canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "frameRate",
        "durationUs",
        "backgroundColor",
        "extensions"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7680
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7680
        },
        "frameRate": {
          "$ref": "#/$defs/Rational"
        },
        "durationUs": {
          "$ref": "#/$defs/PositiveTimeUs"
        },
        "backgroundColor": {
          "$ref": "#/$defs/Color"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      }
    },
    "Fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "value"
      ],
      "properties": {
        "method": {
          "const": "sha256-sampled-v1"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        }
      }
    },
    "RelinkHints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originalFileName",
        "byteLength",
        "lastModifiedMs"
      ],
      "properties": {
        "originalFileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lastModifiedMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fingerprint": {
          "$ref": "#/$defs/Fingerprint"
        }
      }
    },
    "MediaMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationUs": {
          "$ref": "#/$defs/PositiveTimeUs"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "nominalFrameRate": {
          "$ref": "#/$defs/Rational"
        },
        "container": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "videoCodec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "audioCodec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 768000
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "hasAudio": {
          "type": "boolean"
        },
        "rotationDegrees": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        }
      }
    },
    "Asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "linkState",
        "relinkHints",
        "metadata",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "enum": [
            "video",
            "audio",
            "image"
          ]
        },
        "mimeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "linkState": {
          "enum": [
            "unchecked",
            "available",
            "missing"
          ]
        },
        "relinkHints": {
          "$ref": "#/$defs/RelinkHints"
        },
        "metadata": {
          "$ref": "#/$defs/MediaMetadata"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      }
    },
    "VideoClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "order",
        "assetId",
        "startUs",
        "durationUs",
        "sourceStartUs",
        "playbackRate",
        "opacity",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "type": {
          "const": "video"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "assetId": {
          "$ref": "#/$defs/Id"
        },
        "startUs": {
          "$ref": "#/$defs/TimeUs"
        },
        "durationUs": {
          "$ref": "#/$defs/PositiveTimeUs"
        },
        "sourceStartUs": {
          "$ref": "#/$defs/TimeUs"
        },
        "playbackRate": {
          "$ref": "#/$defs/Rational"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      }
    },
    "AudioFades": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fadeInUs",
        "fadeOutUs"
      ],
      "properties": {
        "fadeInUs": {
          "$ref": "#/$defs/TimeUs"
        },
        "fadeOutUs": {
          "$ref": "#/$defs/TimeUs"
        }
      }
    },
    "AudioClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "order",
        "assetId",
        "startUs",
        "durationUs",
        "sourceStartUs",
        "playbackRate",
        "gainDb",
        "muted",
        "fades",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "type": {
          "const": "audio"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "assetId": {
          "$ref": "#/$defs/Id"
        },
        "startUs": {
          "$ref": "#/$defs/TimeUs"
        },
        "durationUs": {
          "$ref": "#/$defs/PositiveTimeUs"
        },
        "sourceStartUs": {
          "$ref": "#/$defs/TimeUs"
        },
        "playbackRate": {
          "$ref": "#/$defs/Rational"
        },
        "gainDb": {
          "type": "number",
          "minimum": -96,
          "maximum": 24
        },
        "muted": {
          "type": "boolean"
        },
        "fades": {
          "$ref": "#/$defs/AudioFades"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      }
    },
    "TextTiming": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "unsynced"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "startUs",
            "durationUs"
          ],
          "properties": {
            "status": {
              "const": "timed"
            },
            "startUs": {
              "$ref": "#/$defs/TimeUs"
            },
            "durationUs": {
              "$ref": "#/$defs/PositiveTimeUs"
            }
          }
        }
      ]
    },
    "LyricLineRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "lineId"
      ],
      "properties": {
        "documentId": {
          "$ref": "#/$defs/Id"
        },
        "lineId": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "TextClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "order",
        "role",
        "text",
        "timing",
        "styleId",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "type": {
          "const": "text"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "enum": [
            "title",
            "caption",
            "lyric"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 20000
        },
        "timing": {
          "$ref": "#/$defs/TextTiming"
        },
        "styleId": {
          "$ref": "#/$defs/Id"
        },
        "lyricLineRef": {
          "$ref": "#/$defs/LyricLineRef"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      }
    },
    "Transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "fromClipId",
        "toClipId",
        "durationUs",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "enum": [
            "cut",
            "crossDissolve",
            "fadeToBlack",
            "fadeFromBlack"
          ]
        },
        "fromClipId": {
          "oneOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "toClipId": {
          "oneOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "durationUs": {
          "$ref": "#/$defs/TimeUs"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      },
      "anyOf": [
        {
          "properties": {
            "fromClipId": {
              "$ref": "#/$defs/Id"
            }
          }
        },
        {
          "properties": {
            "toClipId": {
              "$ref": "#/$defs/Id"
            }
          }
        }
      ]
    },
    "Track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "order",
        "locked",
        "muted",
        "clips",
        "transitions",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "enum": [
            "video",
            "audio",
            "text"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "locked": {
          "type": "boolean"
        },
        "muted": {
          "type": "boolean"
        },
        "clips": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/VideoClip"
              },
              {
                "$ref": "#/$defs/AudioClip"
              },
              {
                "$ref": "#/$defs/TextClip"
              }
            ]
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Transition"
          }
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      }
    },
    "LyricLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "text",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "maxLength": 20000
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      }
    },
    "LyricSyncSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audioAssetId",
        "latencyOffsetUs",
        "endGapUs",
        "lastActiveLineId"
      ],
      "properties": {
        "audioAssetId": {
          "oneOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "latencyOffsetUs": {
          "$ref": "#/$defs/SignedTimeUs"
        },
        "endGapUs": {
          "$ref": "#/$defs/TimeUs"
        },
        "lastActiveLineId": {
          "oneOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "LyricDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceText",
        "lines",
        "syncSettings",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "sourceText": {
          "type": "string",
          "maxLength": 1000000
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LyricLine"
          }
        },
        "syncSettings": {
          "$ref": "#/$defs/LyricSyncSettings"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      }
    },
    "Marker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "timeUs",
        "label",
        "color",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "enum": [
            "generic",
            "beat",
            "section",
            "cue"
          ]
        },
        "timeUs": {
          "$ref": "#/$defs/TimeUs"
        },
        "label": {
          "type": "string",
          "maxLength": 500
        },
        "color": {
          "$ref": "#/$defs/Color"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      }
    },
    "Stroke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "widthPx"
      ],
      "properties": {
        "color": {
          "$ref": "#/$defs/Color"
        },
        "widthPx": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "Shadow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "offsetXPx",
        "offsetYPx",
        "blurPx"
      ],
      "properties": {
        "color": {
          "$ref": "#/$defs/Color"
        },
        "offsetXPx": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "offsetYPx": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "blurPx": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "TextStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "fontFamily",
        "fontSizePx",
        "fontWeight",
        "fontStyle",
        "color",
        "backgroundColor",
        "stroke",
        "shadow",
        "textAlign",
        "writingMode",
        "lineHeight",
        "letterSpacingPx",
        "extensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "const": "text"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "fontSizePx": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "fontWeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "fontStyle": {
          "enum": [
            "normal",
            "italic"
          ]
        },
        "color": {
          "$ref": "#/$defs/Color"
        },
        "backgroundColor": {
          "oneOf": [
            {
              "$ref": "#/$defs/Color"
            },
            {
              "type": "null"
            }
          ]
        },
        "stroke": {
          "$ref": "#/$defs/Stroke"
        },
        "shadow": {
          "$ref": "#/$defs/Shadow"
        },
        "textAlign": {
          "enum": [
            "start",
            "center",
            "end"
          ]
        },
        "writingMode": {
          "enum": [
            "horizontal-tb",
            "vertical-rl",
            "vertical-lr"
          ]
        },
        "lineHeight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "letterSpacingPx": {
          "type": "number",
          "minimum": -100,
          "maximum": 1000
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      }
    },
    "VideoExport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codec",
        "bitrate"
      ],
      "properties": {
        "codec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "bitrate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        }
      }
    },
    "AudioExport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codec",
        "bitrate",
        "sampleRate",
        "channels"
      ],
      "properties": {
        "codec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "bitrate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 768000
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "ExportPreset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "target",
        "container",
        "width",
        "height",
        "frameRate",
        "video",
        "audio",
        "extensions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "target": {
          "enum": [
            "custom",
            "youtube",
            "short",
            "spotifyCanvas"
          ]
        },
        "container": {
          "enum": [
            "mp4",
            "webm"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7680
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7680
        },
        "frameRate": {
          "$ref": "#/$defs/Rational"
        },
        "video": {
          "$ref": "#/$defs/VideoExport"
        },
        "audio": {
          "oneOf": [
            {
              "$ref": "#/$defs/AudioExport"
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      }
    }
  }
}
